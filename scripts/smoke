#!/bin/bash
set -euo pipefail
# Run inside the image; output/build products belong outside the checkout.
# Generated by configure during the image build.
# shellcheck source=/dev/null
source /opt/rustxc/environment
out=${RUSTXC_EVIDENCE_DIR:-/tmp/rustxc-smoke}
mkdir -p "$out" /tmp/rustxc-host-pkgconfig
cat > /tmp/rustxc-host-pkgconfig/rustxc-host-only.pc <<'PC'
Name: rustxc-host-only
Description: host contamination sentinel
Version: 1
Libs: -L/usr/lib -lhost
PC
export PKG_CONFIG_PATH=/tmp/rustxc-host-pkgconfig
export CARGO_TARGET_DIR=$out/target
for target in "$@"; do
    echo "Host $(uname -m); target $target"
    if [[ $target == *-linux-gnu ]]; then
        /opt/rustxc/bin/"$target"-cc -v -E -x c /dev/null
        /opt/rustxc/bin/"$target"-pkg-config --cflags --libs alsa libudev wayland-client xkbcommon x11
    elif [[ $target == *-apple-darwin ]]; then
        /opt/rustxc/bin/"$target"-cc -v -E -x c /dev/null
    fi
    if [[ $target != *-windows-msvc ]]; then
        cmake -S /tests/cmake -B "$out/cmake-$target" -G Ninja \
            "-DCMAKE_TOOLCHAIN_FILE=/opt/rustxc/cmake/$target.cmake" -DCMAKE_BUILD_TYPE=Release
        cmake --build "$out/cmake-$target"
        /opt/rustxc/inspect "$out/cmake-$target/probe"
    fi
    /opt/rustxc/build-target "$target" --manifest-path /tests/native/Cargo.toml --locked --release -vv
    for native in zstd-sys sha2-asm; do
        while IFS= read -r object; do
            llvm-readobj --file-headers "$object"
            break
        done < <(find "$CARGO_TARGET_DIR/$target/release/build" -path "*/$native-*/out/*.o" -type f)
    done
    suffix=; [[ $target != *-windows-msvc ]] || suffix=.exe
    /opt/rustxc/inspect "$CARGO_TARGET_DIR/$target/release/rustxc-native-smoke$suffix"
    case "$target" in
        aarch64-unknown-linux-gnu) expected='ELF 64-bit LSB.*ARM aarch64' ;;
        x86_64-unknown-linux-gnu) expected='ELF 64-bit LSB.*x86-64' ;;
        powerpc64le-unknown-linux-gnu) expected='ELF 64-bit LSB.*PowerPC' ;;
        aarch64-apple-darwin) expected='Mach-O 64-bit arm64' ;;
        x86_64-apple-darwin) expected='Mach-O 64-bit x86_64' ;;
        x86_64-pc-windows-msvc) expected='PE32\+.*x86-64' ;;
        aarch64-pc-windows-msvc) expected='PE32\+.*Aarch64' ;;
    esac
    file "$CARGO_TARGET_DIR/$target/release/rustxc-native-smoke$suffix" | grep -E "$expected"
    case "$target:$(uname -m)" in
        aarch64-unknown-linux-gnu:aarch64|x86_64-unknown-linux-gnu:x86_64)
            cpu=${target%%-*}
            LD_LIBRARY_PATH="/opt/sysroots/$target/usr/lib/$cpu-linux-gnu:/opt/sysroots/$target/lib/$cpu-linux-gnu" \
                "$CARGO_TARGET_DIR/$target/release/rustxc-native-smoke" ;;
    esac
    # Even an explicit host PKG_CONFIG_PATH must not contaminate target discovery.
    if "/opt/rustxc/bin/$target-pkg-config" --exists rustxc-host-only; then
        echo "pkg-config host contamination" >&2; exit 1
    fi
done
